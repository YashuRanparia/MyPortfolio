# Postgres (local: docker compose up -d; prod: Neon pooled connection string)
DATABASE_URL=postgres://constellation:constellation@localhost:5433/constellation
# 32+ random chars: openssl rand -base64 48
SESSION_SECRET=
# Used only by `npm run seed` to create the single admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cloudinary (free plan) - for image/resume uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional AI guide ("Ask" button). Any free OpenAI-compatible provider; leave LLM_API_KEY empty to hide it.
# Groq (default):  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
# OpenRouter:      LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<a ":free" model>
# Gemini:          LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Public origin (canonical URL, sitemap, social cards). Vercel falls back to its own URL.
SITE_URL=
